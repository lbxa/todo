{
  "name": "checklist",
  "version": "1.0.0",
  "private": true,
  "description": "Nestable lists that live in your browser.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun scripts/generate-sw.mjs",
    "start": "npx serve out",
    "test": "bun run build && bun test",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "icons": "bun scripts/generate-icons.mjs",
    "og": "bun scripts/generate-og.mjs"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.123.0"
  }
}
